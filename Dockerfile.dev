# Imagen de desarrollo: solo Node + pnpm. El código se monta como volumen (recarga automática).
FROM node:22-alpine
ARG UID=1000
ARG GID=1000
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NEXT_TELEMETRY_DISABLED=1 COREPACK_HOME=/corepack \
    npm_config_store_dir=/pnpm/store
RUN corepack enable && corepack prepare pnpm@11.28.6 --activate \
  && mkdir -p /app/node_modules /app/.next /pnpm/store /corepack \
  && chown -R ${UID}:${GID} /app /pnpm /corepack
WORKDIR /app
USER ${UID}:${GID}
EXPOSE 3000
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm dev -H 0.0.0.0 -p 3000"]
